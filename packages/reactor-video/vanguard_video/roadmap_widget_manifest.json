  "ui_grammar": {
    "rail": "The flow is represented by a series of connected, variable-width bands (sankey diagram style) that act as the 'rail'.",
    "node_styles": "Nodes are represented by vertical rectangular blocks that span the width of the incoming/outgoing flows. They contain a label, a value, and a percentage. The 'DefiLlama' node is a smaller, central icon.",
