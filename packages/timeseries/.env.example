# Tiger Cloud / TimescaleDB connection.
#
# Preferred: the single DSN from the Tiger Cloud console. SSL is negotiated
# automatically for any non-local host, and `sslmode` is handled by the
# package (pg would otherwise let the DSN override the resolved TLS policy).
TIMESERIES_DATABASE_URL=postgres://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require

# Concurrency cap. Tiger Cloud free tier limits connections; the runner caches
# one pool per process, so keep this small.
TIMESERIES_DB_MAX_CONNECTIONS=5

# Fallback: discrete keys, used when TIMESERIES_DATABASE_URL is unset.
# Local Postgres on localhost connects without TLS.
# TIMESERIES_DB_HOST=localhost
# TIMESERIES_DB_PORT=5432
# TIMESERIES_DB_NAME=agentic_ems
# TIMESERIES_DB_USER=postgres
# TIMESERIES_DB_PASSWORD=

# Vertex AI embeddings for the temporal vector layer (embedding backfill and
# retrieval queries). Auth uses Application Default Credentials — locally via
# `gcloud auth application-default login`, on Vercel via a service-account key.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=text-embedding-005
