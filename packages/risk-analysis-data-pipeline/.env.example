# ─── Risk snapshot storage (GCS) ─────────────────────────────────────────────
#
# Snapshots are written to Google Cloud Storage rather than Vercel Blob: the
# ETL runs on Cloud Run, so staying in-GCP avoids cross-cloud egress on every
# 6-hourly sweep. The always-free tier (5 GiB + 55k ops/month) covers this
# workload comfortably.
RISK_GCS_BUCKET=
RISK_GCS_PREFIX=risk

# Local fallback for development: when the bucket is unset (or --no-cloud is
# passed) snapshots are written here instead, so nothing needs cloud access.
RISK_LOCAL_DIR=./data

# ─── Refresh cadence ─────────────────────────────────────────────────────────
#
# Recorded in the manifest so a consumer can judge staleness. The scheduler
# itself lives in Cloud Scheduler (Vercel Hobby cron cannot run sub-daily).
RISK_REFRESH_CRON=0 */6 * * *

# ─── Observability ───────────────────────────────────────────────────────────
#
# `pretty` for local reading, `json` so the same records are queryable in Cloud
# Logging. The stage-level logging contract is identical in both modes.
RISK_LOG_FORMAT=pretty

# ─── Temporal history (existing Tiger Cloud TimescaleDB) ─────────────────────
#
# Deliberately the SAME instance the timeseries package already uses. No new
# database is provisioned — see plan §3.4.
TIMESERIES_DATABASE_URL=postgres://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require

# ─── Embeddings (governance text, incidents, risk slices) ────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=text-embedding-005

# ─── Service account (headless / Cloud Run) ──────────────────────────────────
#
# Vercel and Cloud Run have no gcloud session, so ADC must be supplied as a
# service-account JSON in an env var. Locally a `gcloud auth
# application-default login` is enough and this can stay empty.
GOOGLE_SERVICE_ACCOUNT_KEY=

# ─── Scraper controls ────────────────────────────────────────────────────────
#
# Bounded by design: a per-source timeout and a page cap keep a sweep from
# becoming a runaway job (plan §9).
RISK_SOURCE_TIMEOUT_S=45
RISK_MAX_PAGES=5
RISK_HEADLESS=true
