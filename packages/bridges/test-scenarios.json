      "rpcEnv": "ETHEREUM_RPC_URL",
      "bridgeChain": "Ethereum"
    },
    "arbitrum": {
      "label": "Arbitrum One",
      "network": "mainnet",
      "chainId": 42161,
      "cctpDomain": 3,
      "lzEid": 30110,
      "rpcEnv": "ARBITRUM_RPC_URL",
      "bridgeChain": "Arbitrum"
    },
    "arc-testnet": {
      "label": "Arc Testnet",
      "network": "testnet",
      "chainId": 0,
      "cctpDomain": 26,
      "lzEid": 0,
      "rpcEnv": "ARC_RPC_URL",
      "_note": "Gas token is USDC, not ETH — see feeTokenDecimals when quoting FROM Arc."
    }
  },
  "wallets": {
    "source": {
      "name": "treasury",
      "envKey": "TEST_SOURCE_PRIVATE_KEY",
      "_note": "The funded EOA that sends. Needs testnet gas AND testnet USDC."
    },
    "destination": {
      "name": "landing",
      "envKey": "TEST_DESTINATION_PRIVATE_KEY",
      "_note": "Where the bridge lands. May be the same key; a distinct one proves the destination is genuinely reachable."
    }
  },
  "apis": {
    "layerzeroScan": {
      "testnet": "https://scan-testnet.layerzero-api.com/v1",
      "_note": "Keyless. The fee itself comes from an on-chain quote, not from here."
    },
    "circleQuote": {
      "sandbox": "https://iris-api-sandbox.circle.com",
      "production": "https://iris-api.circle.com",
      "_note": "Use sandbox for testnet domains. The published reference shows no auth header on the quote endpoint."
    },
    "lifi": {
      "_note": "Keyed via LIFI_API_KEY. Base URL is the SDK's own default."
    }
  },
  "amounts": {
    "_note": "Small and identical across scenarios so the three fees are comparable. USDC has 6 decimals.",
    "usdc": "1000000",
    "usdcLabel": "1.00 USDC"
  },
  "scenarios": [
    {
      "id": "LZ-polygon-to-base",
      "adapter": "layerzero",
      "from": "polygon",
      "to": "base",
      "receiveGas": 200000,
      "_expect": "Endpoint-form quote. No OApp needed."
    },
    {
      "id": "ARC-cctp-sepolia-to-arc",
      "adapter": "circle-cctp",
      "from": "sepolia",
      "to": "arc-testnet",
      "speed": "FAST",
      "_expect": "Chain A -> Arc (domain 26)."
    },
    {
      "id": "MAINNET-lifi-bridge-polygon-to-base",
      "adapter": "lifi",
      "from": "polygon",
      "to": "base",
      "fromToken": "usdc-polygon",
      "toToken": "usdc-base",
      "amount": "1500000"
    },
    {
      "id": "MAINNET-lifi-swap-polygon-usdc-to-weth",
      "adapter": "lifi",
      "from": "polygon",
      "to": "polygon",
      "fromToken": "usdc-polygon",
      "toToken": "weth-polygon",
      "amount": "1500000"
    }
  ],
  "missingConfig": [
    {
      "for": "layerzero",
      "value": "oappByChainId",
      "why": "The LayerZero fee is read from the OApp being called, which is specific to the integration. No default exists.",
      "youProvide": "An OApp (or OFT) address on Sepolia that exposes quote(uint32,bytes,bytes,bool)."
    }
  ],
