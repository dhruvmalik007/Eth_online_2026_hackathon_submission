# Bridge adapters — configuration.
#
# Nothing here is required for the offline test suite: every fixture test runs
# with no credentials, which is what keeps CI hermetic. Keys are needed only for
# the opt-in live checks (`pnpm test:live`) and for real quoting in the service.

# ── LI.FI ─────────────────────────────────────────────────────────────────────
# Optional for low-volume quoting; required for meaningful throughput and for
# execution. Without it LI.FI rate-limits aggressively and quotes fail as 429.
LIFI_API_KEY=
# Base URL override — only needed to point at a self-hosted or staging instance.
LIFI_BASE_URL=

# ── LayerZero ─────────────────────────────────────────────────────────────────
# LayerZero's Scan API needs no key. The Executor/DVN fee comes from the endpoint
# contract's `quoteSend`, which is an on-chain read — so this only needs an RPC.
LAYERZERO_SCAN_BASE_URL=https://scan.layerzero-api.com/v1
# Comma-separated RPC URLs for the endpoint chains we quote from, e.g.
# LAYERZERO_RPCS=ethereum=https://...,base=https://...
LAYERZERO_RPCS= ## https://transfer.layerzero-api.com/v1/quotes

# ── Circle (CCTP / Bridge Kit) ────────────────────────────────────────────────
# Required by Bridge Kit and by the Circle Wallets adapter. The viem adapter
# needs neither, because it signs with our own wallet instead of Circle's.
CIRCLE_TEST_API_KEY= ## for the testnet implementation for tests . 
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# ── Shared ────────────────────────────────────────────────────────────────────
# Used by the viem adapter and by on-chain reads (CCTP attestation checks).
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=

## Private key: only for the example testing of the bridging setup.
PRIVATE_KEY=

## ALCHEMY core end RPC's support 
ALCHEMY_API_KEY=