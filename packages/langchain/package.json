{
  "name": "@ethonline2026/langchain-agent",
  "version": "0.1.0",
  "description": "Agentic inference layer for The Graph protocol data \u2014 Bloomberg-style risk analytics (Greeks, VaR, stress tests) via LangChain/LangGraph with Vertex AI, plus a deterministic fixed-income strategy execution pipeline.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "cli": "tsx src/cli.ts",
    "probe:levelA": "tsx scripts/levelA-tool-probe.ts",
    "probe:levelB": "tsx scripts/levelB-trace-probe.ts",
    "graphclient:build": "graphclient build",
    "graphclient:serve-dev": "graphclient serve-dev",
    "probe:levelA-v01": "tsx scripts/levelA-v01-probe.ts"
  },
  "dependencies": {
    "@ethonline2026/arc-client": "workspace:*",
    "@ethonline2026/graph-fno-indexer": "workspace:*",
    "@ethonline2026/timeseries": "workspace:*",
    "@graphprotocol/client-auto-pagination": "^2.0.0",
    "@graphprotocol/client-cli": "^3.0.7",
    "@langchain/core": "^1.2.9",
    "@langchain/google-vertexai": "^2.3.0",
    "@langchain/langgraph": "^1.4.14",
    "deepagents": "^1.13.3",
    "dotenv": "^17.4.2",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "graphql-tag": "^2.12.7",
    "langchain": "^1.5.10",
    "mathjs": "^15.2.0",
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.9.0",
    "eslint": "^9.39.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^3.2.4"
  }
}
