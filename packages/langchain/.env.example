# ─────────────────────────────────────────────────────────────────────────────
# Vertex AI Configuration (serverless LLM inference)
# Auth via gcloud ADC: `gcloud auth application-default login`
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash-lite
VERTEX_AI_TEMPERATURE=0.1

# ─────────────────────────────────────────────────────────────────────────────
# LangSmith Tracing (Level B/C — per .agents/skills/langsmith-trace)
# For LangChain OSS apps tracing is AUTOMATIC once these are set.
#
# ⚠️ EU-REGION ACCOUNTS: a valid key against the default US endpoint returns
# 403 Forbidden. You MUST set LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# (Settings → API key creation shows your region; org/workspace ids come from
# LangSmith → Settings → Organization).
# If LANGSMITH_PROJECT does not exist yet, leave it unset — the SDK auto-creates
# the project on first trace.
# ─────────────────────────────────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_ORG_ID=your-org-uuid
LANGSMITH_WORKSPACE_ID=your-workspace-uuid
LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=ethonline2026-fixed-income

# ─────────────────────────────────────────────────────────────────────────────
# Arc — settlement hub (CCTP V2 via App Kit Bridge; ERC-8183 ACP kernel)
# Public mainnet: Sept 16, 2026. Until then ARC_NETWORK=arc-testnet.
# ⚠️ Arc-side contract addresses (USDC, TokenMessengerV2, MessageV2, ACP kernel,
# RiskEvaluatorHook) must be verified against docs.arc.network before mainnet —
# placeholders in code are ENV-DRIVEN on purpose.
# ─────────────────────────────────────────────────────────────────────────────
ARC_NETWORK=arc-testnet
ARC_PRIVATE_KEY=
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_TESTNET_USDC=
ARC_TESTNET_TOKEN_MESSENGER_V2=
ARC_TESTNET_MESSAGE_V2=
ARC_TESTNET_CCTP_DOMAIN=25
# ARC_MAINNET_RPC_URL=
# ARC_MAINNET_USDC=
# ARC_MAINNET_TOKEN_MESSENGER_V2=
# ARC_MAINNET_MESSAGE_V2=
# ARC_MAINNET_CCTP_DOMAIN=26
ARC_ACP_KERNEL=
ARC_RISK_EVALUATOR_HOOK=
# STABLEFX_RATE_USDC_EURC=0.92

# ─────────────────────────────────────────────────────────────────────────────
# The Graph Endpoints (same as the-graph package)
# ─────────────────────────────────────────────────────────────────────────────
GATEWAY_API_KEY=your-gateway-api-key
STUDIO_PERP_SEPOLIA_ENDPOINT=https://api.studio.thegraph.com/query/YOUR_ID/YOUR_SUBGRAPH/v0.0.1

# ─────────────────────────────────────────────────────────────────────────────
# Uniswap v4 Subgraph
# Default: official Ethereum mainnet deployment (queried via gateway with
# GATEWAY_API_KEY). The official v4 subgraph is NOT available on Sepolia —
# to run against Sepolia, self-deploy github.com/Uniswap/v4-subgraph to
# Subgraph Studio and set UNISWAP_V4_STUDIO_ENDPOINT below.
# ─────────────────────────────────────────────────────────────────────────────
UNISWAP_V4_SUBGRAPH_ID=DiYPVdygkfjDWhbxGSqAQxwBKmfKnkWQojqeM2rkLb3G
# UNISWAP_V4_STUDIO_ENDPOINT=https://api.studio.thegraph.com/query/YOUR_ID/uniswap-v4-sepolia/v0.0.1

# ─────────────────────────────────────────────────────────────────────────────
# Wallet Configuration (optional, for on-chain interactions)
# ─────────────────────────────────────────────────────────────────────────────
WALLET_MODE=readonly
WALLET_PRIVATE_KEY=
WALLET_LEDGER_PATH=
WALLET_ADDRESS=

# ─────────────────────────────────────────────────────────────────────────────
# RPC Endpoints (defaults to public nodes)
# ─────────────────────────────────────────────────────────────────────────────
RPC_URL_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
RPC_URL_BASE_SEPOLIA=https://base-sepolia-rpc.publicnode.com
RPC_URL_ARBITRUM_SEPOLIA=https://arbitrum-sepolia-rpc.publicnode.com
RPC_URL_OPTIMISM_SEPOLIA=https://optimism-sepolia-rpc.publicnode.com
