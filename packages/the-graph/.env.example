# --- The Graph ----------------------------------------------------------------
# Subgraph Studio gateway key (https://thegraph.com/studio/ -> API Keys).
# Used by: MCP server auth header, network-tier queries, graphclient config.
GATEWAY_API_KEY=

# Your OWN Studio deployment endpoints (created via the-graph/deriv-perp P5 runbook).
# Format: https://api.studio.thegraph.com/query/<ACCOUNT_ID>/<SUBGRAPH_SLUG>/<VERSION>
STUDIO_PERP_SEPOLIA_ENDPOINT=

# --- On-chain interaction (OPTIONAL for data-only mode) -----------------------
# Dry-run testnet mode works without any of these.
#
# Preferred: Ledger EOA via v2 payload (path + address, NO private key leaves the device).
#   WALLET_MODE=ledger
#   WALLET_LEDGER_PATH="44'/60'/0'/0/0"
#   WALLET_ADDRESS=0x...
#   (requires Ledger connected + Ethereum app open)
WALLET_MODE=
WALLET_LEDGER_PATH=
WALLET_ADDRESS=

# Fallback: plaintext EOA private key (TESTNET ONLY - never fund with mainnet assets).
#   WALLET_MODE=private-key
WALLET_PRIVATE_KEY=

# RPC endpoints (public defaults are rate-limited; set your own for CI)
RPC_URL_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
RPC_URL_BASE_SEPOLIA=https://base-sepolia-rpc.publicnode.com
RPC_URL_ARBITRUM_SEPOLIA=https://arbitrum-sepolia-rpc.publicnode.com
RPC_URL_OPTIMISM_SEPOLIA=https://optimism-sepolia-rpc.publicnode.com
