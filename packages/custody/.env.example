# Custody package config — NO secrets live here.
#
# Exception, deliberate and documented: the Privy server-wallet path below needs
# credentials. They belong in Secret Manager / the OS keychain and are read from
# the environment at runtime; they are never written to disk by this package.
# The default signer is `dry`, which needs none of them.

# Which owner signer this process uses:
#   dry       — build proposals and intents, never sign (default)
#   privy     — a Privy server wallet signs; key custody stays with Privy
#   local-key — a local viem key signs; DEV/TEST ONLY, never with funds
CUSTODY_SIGNER=dry

# custody mode: dry (default; proposals + calldata only) | live
# Note: dry means "no signer", not "no network" — protocol-kit reads the chain
# id at initialisation, so a reachable RPC is still required.
CUSTODY_MODE=dry

# Safe smart account (deployed in `custody safe deploy`)
CUSTODY_SAFE_ADDRESS=
CUSTODY_SAFE_CHAIN=sepolia

# Safe owners + threshold. Leave CUSTODY_SAFE_OWNERS blank to use the resolved
# owner alone (the signer's address in live mode). Listing more than one owner is
# how a single Safe is shared — e.g. a Privy server-wallet EOA and a Ledger EOA —
# without this package knowing which is which.
#
# A threshold of 1 with the Privy wallet as the only owner is what makes an
# unattended backend signature possible.
CUSTODY_SAFE_OWNERS=
CUSTODY_SAFE_THRESHOLD=1

# ── Privy server wallet (CUSTODY_SIGNER=privy) ───────────────────────────────
# Dashboard steps that are NOT scriptable: create an authorization key, create a
# server wallet, add it as a Safe owner, and author a policy that ALLOWS
# eth_signTypedData_v4 — Privy policies are default-deny.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# base64 PKCS#8, with or without the dashboard's `wallet-auth:` prefix.
PRIVY_AUTHORIZATION_PRIVATE_KEY=
# The wallet the service signs with. `privy:resolve` prints these; the address
# must also appear in CUSTODY_SAFE_OWNERS (threshold 1) or nothing can sign.
PRIVY_WALLET_ID=
PRIVY_WALLET_ADDRESS=
# Optional: the policy id that provides the server-side hard stop.
PRIVY_POLICY_ID=

# ── local key (CUSTODY_SIGNER=local-key) — DEV/TEST ONLY ─────────────────────
# Never fund this. Present so the intent → signature → recovery chain is testable
# without a custodian; the e2e script defaults to a public Hardhat test key.
CUSTODY_E2E_PRIVATE_KEY=

# Ledger-derived scoped agent key (proposer role). Issued via `custody ring issue-agent-key`
# and stored ring-encrypted; custody decrypts at runtime into process memory only.
CUSTODY_AGENT_KEY_REF=agent-scoped-0

# Key Ring password source (never literal): e.g. WALLET_PASS=$(security find-generic-password ...)
WALLET_PASS=

# Audit log location (append-only JSONL)
CUSTODY_LOG_PATH=./custody-audit.jsonl

# Optional: Safe Transaction Service (used for proposal queueing in live mode)
CUSTODY_SAFE_TX_SERVICE_URL=https://safe-transaction-sepolia.safe.global

# Sepolia RPC (read-only usage; execution RPC via user's own provider)
ETHEREUM_SEPOLIA_RPC_URL=