# Aqua / SwapVM execution layer — configuration.
#
# Nothing here is required for the offline test suite. The registry, the policy
# and the program builders are pure, and the fork suite takes its RPC from the
# command line, so CI stays hermetic. These are needed only to run the fork
# scenarios against a real chain.

# ── Forking ──────────────────────────────────────────────────────────────────
# One RPC per chain in the phase-1 matrix. `scenario:*` reads the one matching
# --chain, so a single chain can be exercised without configuring all four.
ETHEREUM_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=

# Pin the fork. Evidence records this block, so a moved chain head would make a
# recorded run irreproducible: the vault share price and every quote move with it.
ETHEREUM_FORK_BLOCK=
ARBITRUM_FORK_BLOCK=
OPTIMISM_FORK_BLOCK=
POLYGON_FORK_BLOCK=

# ── Registry overrides ───────────────────────────────────────────────────────
# The curated Morpho vault addresses ship in source. Override here to point a
# scenario at a different vault without editing the registry — useful because a
# vault can be paused or drained, and a demo should not need a rebuild to move.
MORPHO_VAULTS_OVERRIDE=

# Optional. Only the Midnight fixed-rate leg needs an indexed offer source; the
# vault and Aqua legs read the chain directly.
MORPHO_API_KEY=
