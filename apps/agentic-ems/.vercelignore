# Keep the deploy upload lean: these are build artifacts or unused media that
# would otherwise be shipped on every deploy.
.next
node_modules
tsconfig.tsbuildinfo
*.mp4
!public/demo-pitch.mp4
.DS_Store
.vercel/output

# Values files. `.env.local` and the per-environment files hold real credentials, and a CLI deploy
# reads THIS file rather than the app's `.gitignore` — which excludes `.env` but, before this, was
# not consulted here at all.
.env*
