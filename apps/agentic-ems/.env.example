# Required. The server mints short-lived, session-scoped JWTs from this;
# the browser never sees the raw key. rk_... from
# https://www.reactor.inc/account/api-keys
REACTOR_API_KEY=

# Required for /demo auth + wallet provisioning. Public identifier — safe to
# expose to the browser (Privy ships it client-side in every app).
# Get it from https://dashboard.privy.io → Configuration → App settings → Basics.
# Also required in the dashboard: Email enabled as a login method, smart wallets
# enabled (type: Safe, networks: Base/Polygon/Optimism), and this origin added to
# allowed domains. Login is email + one-time code — no OAuth redirect domains
# needed. Do NOT add the App Secret here — this app never uses it.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional: bring your own OpenAI-compatible key and the episode composer
# gains a "Write scenes with AI" button (served by /api/upsample). Without
# it, you write each scene by hand — the composer guides you.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
