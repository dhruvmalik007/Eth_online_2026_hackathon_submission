# Required. The server mints short-lived, session-scoped JWTs from this;
# the browser never sees the raw key. rk_... from
# https://www.reactor.inc/account/api-keys
REACTOR_API_KEY=

# Required for /demo auth + wallet provisioning. Public identifier — safe to
# expose to the browser (Privy ships it client-side in every app).
# Get it from https://dashboard.privy.io → Configuration → App settings → Basics.
# Also required in the dashboard: Email enabled as a login method, and smart
# wallets enabled (type: Safe, networks: Base/Polygon/Optimism). Login is email
# + one-time code — no OAuth redirect domains needed. Do NOT add the App Secret
# here — this app never uses it.
#
# Leave "allowed domains" empty while you deploy previews. Setting it restricts
# the app to exactly the origins listed, and Privy rejects generic patterns like
# https://*.vercel.app by design (anyone can deploy to such a hostname) — so a
# pinned list breaks every PR preview URL.
NEXT_PUBLIC_PRIVY_APP_ID=

# Required. The desk exchanges a Privy access token for a session once, at
# sign-in, and verifies it here. This is the *verification key*, not the App
# Secret — it verifies locally with no round trip to Privy, and this app still
# never reads the secret. From dashboard.privy.io → Configuration → App
# settings → Basics → Verification key.
PRIVY_VERIFICATION_KEY=

# Required. Signs the session cookie the browser carries after that exchange,
# so rotating it signs everyone out. Any random 32-byte value:
#   openssl rand -base64 32
AUTH_SECRET=

# Optional: bring your own OpenAI-compatible key and the episode composer
# gains a "Write scenes with AI" button (served by /api/upsample). Without
# it, you write each scene by hand — the composer guides you.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
