{
  "name": "@ethonline2026/fork-execution",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local fork harness for the Agentic EMS: pinned Anvil forks, deployed contracts, verified registry state, and committed evidence.",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "doctor": "tsx src/index.ts doctor",
    "smoke": "tsx src/index.ts smoke",
    "flight": "tsx src/index.ts flight",
    "deploy": "tsx src/index.ts deploy",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ethonline2026/execution-domain": "workspace:*",
    "@ethonline2026/oneinch-aqua": "workspace:*",
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
