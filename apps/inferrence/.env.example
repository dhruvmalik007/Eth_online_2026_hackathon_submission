# ---------------------------------------------------------------------------
# apps/inferrence — environment
#
# Defaults are the safe/offline settings: `dry` mode with a mock agent and the
# local sandbox double. A deployment flips INFERENCE_MODE=live and
# SANDBOX_PROVIDER=cloudrun and supplies the credentials below.
# ---------------------------------------------------------------------------

# --- service -----------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
INFERENCE_MODE=dry                 # dry | live  (the broadcast gate)
# Where state lives — a separate question from the broadcast gate, so a real-agent
# revision can run without claiming to be broadcast-live.
INFERENCE_PERSISTENCE=memory       # memory | timescale  (timescale = ROADMAP T1.1/T1.3)
AGENT_IMPL=mock                    # mock | langchain
INFERENCE_MAX_CONCURRENT_RUNS=8
INFERENCE_RUN_TIMEOUT_MS=600000
INFERENCE_SSE_HEARTBEAT_MS=15000

# --- sandbox -----------------------------------------------------------------
# local   — confined child process; dev/test only, no isolation boundary
# remote  — the gen2 sandbox-runner (required on gen1: Cloud Run sandboxes need gen2)
# cloudrun — in-process Cloud Run sandboxes (needs the gen2 execution environment)
SANDBOX_PROVIDER=local             # local | remote | cloudrun
SANDBOX_SERVICE_URL=               # required when SANDBOX_PROVIDER=remote
SANDBOX_MAX_PER_INSTANCE=8
SANDBOX_TTL_MS=900000
SANDBOX_ROOT=/tmp/inferrence-sandboxes
# Comma-separated host allowlist. Empty = deny all egress from a sandbox.
SANDBOX_EGRESS_ALLOWLIST=

# --- models (Vertex AI / Gemini) ---------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# JSON service-account key; materialized to /tmp on cold start (Vercel/Cloud Run).
# Locally, an `gcloud auth application-default login` session is enough.
GOOGLE_SERVICE_ACCOUNT_KEY=
VERTEX_AI_MODEL=gemini-2.5-flash-lite
VERTEX_AI_TEMPERATURE=0.1
VERTEX_EMBEDDING_MODEL=text-embedding-005
LANGCHAIN_MODEL_PARSER=
LANGCHAIN_MODEL_SYNTHESIS=

# --- TimesFM-3 (self-hosted Cloud Run GPU service) ---------------------------
# NOTE: TimesFM 3.0 pretrained weights are non-commercial. See ROADMAP T5.5.
# Forecasting needs BOTH halves: the window is read from TimescaleDB, so this service alone has nothing
# to predict from. `/health` reports the group as omitted until both are set.
TIMESFM3_SERVICE_URL=https://timesfm3-inference-7xkkxg6xiq-uc.a.run.app

# --- TimescaleDB (sessions / runs / events / forecasts) ----------------------
TIMESERIES_DATABASE_URL=
TIMESERIES_DB_MAX_CONNECTIONS=5
# The timeseries tool bundle also includes `VectorRepository`, which needs an embedding client — so
# `GOOGLE_CLOUD_PROJECT` above is a third requirement for that group, not just a model setting.

# --- data sources ------------------------------------------------------------
GATEWAY_API_KEY=
STUDIO_PERP_SEPOLIA_ENDPOINT=
UNISWAP_V4_SUBGRAPH_ID=
RISK_GCS_BUCKET=
RISK_LOCAL_DIR=
LIFI_API_KEY=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# --- Web3 custody / signing (DMK) --------------------------------------------
ARC_NETWORK=
ARC_TESTNET_RPC_URL=
# Which owner signer custody uses: dry (propose only) | privy | local-key.
# `privy` needs PRIVY_* here (or in Secret Manager); see packages/custody/.env.example.
CUSTODY_SIGNER=dry                 # dry | privy | local-key
CUSTODY_MODE=dry                   # dry | live
CUSTODY_SAFE_ADDRESS=
CUSTODY_SAFE_CHAIN=ethereum-sepolia
CUSTODY_SAFE_TX_SERVICE_URL=
ETHEREUM_SEPOLIA_RPC_URL=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_PRIVATE_KEY=
PRIVY_WALLET_ID=
PRIVY_POLICY_ID=

# --- observability (LangSmith) ------------------------------------------------
# Traces are per-operation: one root run per turn, one child run per agent step,
# one per external call (sandbox, forecast, custody). Latency comes from the run,
# tokens/cost from usage_metadata, categorical facts from tags, and per-operation
# numbers from feedback scores — numeric metadata is not aggregatable in LangSmith.
# `LANGSMITH_TRACING=true` with no key is reported rather than obeyed silently: `/health` returns
# `tracing.enabled: true, tracing.keyPresent: false`, and a warning is logged at boot. That combination
# was previously indistinguishable from working until someone noticed an empty dashboard, at which point
# they were debugging the instrumentation instead of the telemetry. The key is never echoed by `/health`
# (only whether one is present), so the block is safe to paste into a ticket.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# EU accounts MUST set this: a valid EU key against the default US host 403s on
# every call. https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=
LANGSMITH_ORG_ID=
LANGSMITH_WORKSPACE_ID=
# Must match the project `packages/langchain` traces to. The SDK *creates* a project when the name is
# unknown, so two names means two projects and telemetry that looks lost rather than split.
LANGSMITH_PROJECT=ethonline2026-fixed-income
# Optional, and preferable alongside the name: a project can be addressed by id, which survives a rename.
LANGSMITH_PROJECT_ID=
