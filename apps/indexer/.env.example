# ─────────────────────────────────────────────────────────────────────────────
# apps/indexer — environment
#
# Locally: copy to .env.local (vercel dev reads it) or export in your shell.
# On Vercel: set these as project environment variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── TimescaleDB (Tiger Cloud) ────────────────────────────────────────────────
# The single DSN from the Tiger Cloud console. Non-local hosts get TLS
# automatically; the package owns the SSL policy, so a `sslmode` in the DSN is
# stripped rather than allowed to override it.
TIMESERIES_DATABASE_URL=postgres://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
# Tiger Cloud free tier caps connections; one pool is cached per instance.
TIMESERIES_DB_MAX_CONNECTIONS=5

# ── TimesFM-3 inference service (Cloud Run, GPU) ─────────────────────────────
TIMESFM3_SERVICE_URL=https://timesfm3-inference-887606357212.us-central1.run.app

# ── Vertex AI (Gemini + embeddings) ──────────────────────────────────────────
# Locally, ADC from `gcloud auth application-default login` is enough.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash
VERTEX_EMBEDDING_MODEL=text-embedding-005

# On Vercel there is no gcloud session and no persistent disk. Paste the
# service-account JSON here (single line); the runtime materializes it to
# /tmp and points GOOGLE_APPLICATION_CREDENTIALS at it on cold start.
GOOGLE_SERVICE_ACCOUNT_KEY=

# ── The Graph (deep-agent data tools) ────────────────────────────────────────
GATEWAY_API_KEY=

# ── LangSmith tracing (optional) ─────────────────────────────────────────────
# EU-region accounts must set the EU endpoint, or a valid key returns 403.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=

# ── Scheduled maintenance ────────────────────────────────────────────────────
# The Cloud Run Job (`indexer-cache-refresh`) presents this as a bearer token to
# POST /api/cron/probe — the only writer of the `model_probes` history that
# /api/model-status reports. Generate it locally, never with a third-party tool:
#
#   openssl rand -base64 32
#
# Unset, the route fails closed with a 500 naming this variable, rather than
# becoming an open trigger anyone can call to write probe rows.
CRON_SECRET=

# The private bucket the refresh job writes and GET /api/cache/manifest reads.
# Private on purpose: /api/cache/manifest signs short-lived URLs for the browser,
# so the payloads come from Google's edge without the bucket being world-readable.
# Unset, that route reports itself unconfigured and the console reads live only.
CACHE_BUCKET=

# ── Keyless Google credentials ───────────────────────────────────────────────
# Workload identity federation: this deployment holds no private key. Vercel signs
# an OIDC token per invocation, GCP's Security Token Service exchanges it for a
# short-lived token for GCP_SERVICE_ACCOUNT_EMAIL, and IAM decides who may assume
# that identity — pinned to this project and these environments, nothing global.
#
# The identity needs roles/aiplatform.user, read on the cache bucket, and
# roles/iam.serviceAccountTokenCreator on *itself* so it can sign URLs without a
# key. It needs nothing else, and there is no secret to rotate or leak.
#
# All four are optional: a local `gcloud` session, and a deployment still holding
# a service-account key, both work without them.
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
