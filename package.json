{
  "name": "@ethonline2026/agentic-ems",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic EMS — deterministic fixed-income strategy engine across The Graph, Arc, 1inch, and Uniswap v4. ETHOnline 2026.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:graph": "turbo run build --filter=@ethonline2026/graph-fno-indexer",
    "build:arc": "turbo run build --filter=@ethonline2026/arc-client",
    "build:langchain": "turbo run build --filter=@ethonline2026/langchain-agent",
    "build:inferrence": "turbo run build --filter=@ethonline2026/inferrence",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules",
    "env:check": "pnpm --filter @ethonline2026/env exec node dist/cli.js check --env local",
    "env:check:staging": "pnpm --filter @ethonline2026/env exec node dist/cli.js check --env staging --strict --file .env.staging",
    "env:example": "pnpm --filter @ethonline2026/env exec node dist/cli.js example",
    "env:manifest": "pnpm --filter @ethonline2026/env exec node dist/cli.js manifest",
    "env": "pnpm --filter @ethonline2026/env exec node dist/cli.js"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "keccak",
      "node-hid",
      "usb"
    ]
  },
  "engines": {
    "node": ">=22.6.0",
    "pnpm": ">=10.0.0"
  }
}
