# Generated from @ethonline2026/env — do not edit by hand.
# Environment: local
# Secrets are left blank on purpose; fill them from your secret store.

# == shared ======================================================
# Which environment this process serves. Selects every URL, database and key prefix. — optional, enum
EMS_ENV=local
# Pino log level. — optional, enum
LOG_LEVEL=info

# == execution ===================================================
# Pino log level. — optional, enum
LOG_LEVEL=info
# Postgres/TimescaleDB DSN. Required outside local; local uses the docker compose instance. — optional, secret, dsn
TIMESERIES_DATABASE_URL=
# Upper bound on pooled connections per instance. — optional, number
TIMESERIES_DB_MAX_CONNECTIONS=5
# Upstash Redis REST URL. Required in staging and production; local uses the in-memory CachePort. — optional, secret, url
REDIS_URL=
# Upstash Redis REST token. — optional, secret
REDIS_TOKEN=
# Vercel Blob token for app artifacts (renders, evidence, exports). — optional, secret
BLOB_READ_WRITE_TOKEN=
# Vercel Global Config connection string for runtime flags and per-env service URLs. — optional, secret
EDGE_CONFIG=
# `dry` simulates and records; `live` may broadcast. — optional, enum
EXECUTION_MODE=dry
# HTTP port; Cloud Run injects it. — optional, port
PORT=8080
# Bind address. — optional
HOST=0.0.0.0
# Events buffered before a forced flush; bounds memory per instance. — optional, number
EXECUTION_EVENT_BUFFER=128
# Whether the 1inch Aqua/SwapVM venue is offered at all. — optional, flag
ONEINCH_AQUA_ENABLED=false
# Chains where the venue may be offered. — optional, csv
ONEINCH_AQUA_CHAINS=optimism,polygon
# Delta below which switching venue is not worth making. — optional, number
ONEINCH_MIN_EFFICIENCY_BPS=20
# Whether an agent mandate may enable the venue itself. — optional, flag
ONEINCH_AGENT_ENABLEMENT=false
# Delta above which enabling is arithmetic, so an agent may act. — optional, number
ONEINCH_AGENT_MIN_EFFICIENCY_BPS=100
# Whether an operator must approve an intent before it executes. — optional, flag
APPROVAL_REQUIRED_BY_DEFAULT=true
# Most one agent may commit in a single intent, in whole USD. — optional, number
APPROVAL_MAX_SPEND_USD=250000
# Privy App ID (a public identifier). — optional
PRIVY_APP_ID=
# Privy App Secret (server-side). — optional, secret
PRIVY_APP_SECRET=
# Privy verification key; removes a round-trip from cold start. — optional, secret
PRIVY_VERIFICATION_KEY=
# Key the service signs and broadcasts with. Absent means the signer routes answer 503. — optional, secret
EXECUTION_SIGNER_PRIVATE_KEY=
# Backup payer used only when the primary is absent. — optional, secret
EXECUTION_FALLBACK_SIGNER_PRIVATE_KEY=
# Chain the signer binds to. — optional
EXECUTION_SIGNER_CHAIN=base-sepolia
# RPC overriding the signer chain default. — optional, url
EXECUTION_SIGNER_RPC_URL=
# LI.FI API key for quotes and routes. — optional, secret
LIFI_API_KEY=

