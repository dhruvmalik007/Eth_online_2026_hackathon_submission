RISK_REFRESH_CRON=0 */6 * * *
# Risk pipeline log format. — optional, enum
RISK_LOG_FORMAT=json
# Per-source fetch timeout. — optional, number
RISK_SOURCE_TIMEOUT_S=30
# Page cap per source. — optional, number
RISK_MAX_PAGES=20
# Run the browser scraper headless. — optional, flag
RISK_HEADLESS=true

# == fork-execution ==============================================
# Where fork simulation runs: `local`, the stateless `vercel` façade, or the full `cloudrun` Anvil job. — optional, enum
FORK_EXECUTION_RUNTIME=local
# Alchemy key used to build RPC URLs. — optional, secret
ALCHEMY_API_KEY=
# Agent address used in fork scenarios. — optional
FORK_AGENT_ADDRESS=
# Owner of the fork router. — optional
FORK_ROUTER_OWNER=
# Directory holding fork contract artefacts. — optional, path
FORK_CONTRACTS_DIR=
# Where evidence JSON is written. — optional, path
FORK_EVIDENCE_DIR=
# Port the local Anvil fork listens on. — optional, port
FORK_ANVIL_PORT=8545
