# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# The Python template above ignores `lib/` for build output, but that pattern
# matches ANY directory named `lib` — including TS source. It silently hid
# `packages/ux-workflow/src/lib/`, which meant a fresh clone could not build and
# Cloud Build could not build (the source upload follows ignore rules).
# A negation must re-include the directory before its contents, or git never
# descends into it.
!packages/*/src/lib/
!packages/*/src/lib/**
# Same for app-level source: apps/agentic-ems/lib is application code, not a
# build directory, and was being hidden by the same `lib/` rule.
!apps/*/lib/
!apps/*/lib/**
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

node_modules
.env


