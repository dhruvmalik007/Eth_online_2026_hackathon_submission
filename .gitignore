archive

.agents

# Vercel CLI state: build output plus pulled environment files. Never commit.
.vercel

# Local database credentials — never commit.
# These are already ignored per-package (packages/timeseries/.gitignore), so
# nothing is currently at risk; this root rule is defence in depth so a package
# restructure, a renamed copy, or a lost .gitignore cannot leak a live DSN.
*-creds.md

# Next.js build output. The app-level .gitignore covers apps/agentic-ems, but a
# fresh clone must not pick up a stray .next from any other location.
.next/

# macOS metadata and stray scratch files.
.DS_Store
--full-page

# Generated media stays out of history; heavy assets live in archive/ (ignored).
*.mov
*.mp4
# Foundry build output and dependency cache (packages/*/contracts).
# `lib/` is already covered globally above; these are the compiler outputs that
# must never enter history.
packages/*/contracts/out/
packages/*/contracts/cache/
packages/*/contracts/broadcast/

# Scratch data dumps — regenerable, not part of the deliverable
data/*.batch.jsonl
data/higgsfield_trigger_text.txt

# lib/ is a Python-template ignore; these TypeScript lib dirs are source, not build output.
!apps/*/app/lib/
!apps/*/app/lib/**
!packages/*/scripts/lib/
!packages/*/scripts/lib/**
